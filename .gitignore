# OS
.DS_Store

# Private planning docs - never commit anything in this directory
docs-private/

# Secrets and local environment
.env
.env.*
*.local.json
credentials*.json
service-account*.json
google-services.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Android
*.apk
*.aab
*.keystore
*.jks
local.properties
.gradle/
app/build/
build/
captures/

# Kotlin compiler session files
.kotlin/

# iOS / Xcode (project generated on the Mac)
# Firebase iOS config is a secret, same as google-services.json on Android.
GoogleService-Info.plist
# User- and machine-specific Xcode state and build output.
xcuserdata/
*.xcuserstate
DerivedData/
build/ios/
# Signing/config that may carry a team id or key; keep local.
iosApp/Configuration/Config.xcconfig
# The Xcode project is generated from iosApp/project.yml with xcodegen.
iosApp/ChainCheck.xcodeproj/
# CocoaPods (only if the Mac setup uses Pods instead of SPM).
Pods/
*.xcworkspace/xcuserdata/
